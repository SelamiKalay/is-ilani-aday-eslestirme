N8N_API_KEY=gizli-anahtar-123

# ─── Gemini ──────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Gmail SMTP ──────────────────────────────────
GMAIL_USER=senin@gmail.com
