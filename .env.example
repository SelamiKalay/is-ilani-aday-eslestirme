# ─── PostgreSQL ──────────────────────────────────
POSTGRES_DB=jobmatching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sifre123          # Üretimde güçlü bir şifreyle değiştir

# ─── N8n ─────────────────────────────────────────
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123    # Üretimde değiştir

# ─── N8n Webhook API Key ─────────────────────────
